generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String?
  role        String    @default("member") // admin | member
  avatarUrl   String?
  status      String    @default("invited") // invited | active | suspended
  invitedAt   DateTime?
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions   UserPermission[]
  projectAccess ProjectAccess[]
  ownedProjects Project[]        @relation("ProjectOwner")
  assignedTasks    Task[]           @relation("TaskAssignee")
  createdTasks     Task[]           @relation("TaskCreator")
  taskAssignments  TaskAssignee[]
  emailSignatures  EmailSignature[]
  notes         Note[]
  activities    ActivityLog[]
  notifications Notification[]
  sentInvites       Invitation[]      @relation("InvitedBy")
  aiChats           AiChat[]
  uploadedDocuments CompanyDocument[] @relation("DocumentUploader")
  createdEvents  CalendarEvent[]  @relation("EventCreator")
  eventAttendees EventAttendee[]
  chatRoomsCreated ChatRoom[]     @relation("ChatRoomCreator")
  chatMemberships  ChatMember[]
  chatMessages     ChatMessage[]
  savedLeads       SavedLead[]    @relation("SavedLeadOwner")
  leadSearches     LeadSearch[]   @relation("LeadSearchOwner")
  peopleSearches   PeopleSearch[] @relation("PeopleSearchOwner")
  contactsCreated  Contact[]      @relation("ContactCreator")
  opportunitiesCreated Opportunity[] @relation("OpportunityCreator")
  automationsCreated   Automation[]  @relation("AutomationCreator")
  passwordResetTokens  PasswordResetToken[]
  gmailTokens          GmailToken[]         @relation("GmailTokenOwner")
  assignedContacts     Contact[]            @relation("ContactAssignee")
  callsInitiated       Call[]               @relation("CallInitiator")
  sitesCreated         Site[]               @relation("SiteCreator")
  siteAssetsUploaded   SiteAsset[]          @relation("SiteAssetUploader")
  pageVersionsCreated  PageVersion[]        @relation("PageVersionCreator")
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  name        String
  role        String    @default("member")
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  defaultPermissions String @default("[]") // JSON array of permission types
  projectAccess      String @default("[]") // JSON array of {projectId, accessLevel}
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model UserPermission {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionType String
  createdAt      DateTime @default(now())

  @@unique([userId, permissionType])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("active") // active | on-hold | completed | archived
  color       String    @default("#0F7B8A")
  ownerId     String
  owner       User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  isPrivate   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks         Task[]
  notes         Note[]
  projectAccess ProjectAccess[]
}

model ProjectAccess {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accessLevel String   @default("viewer") // viewer | contributor | manager
  grantedById String
  createdAt   DateTime @default(now())

  @@unique([userId, projectId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("todo") // backlog | todo | in-progress | review | done
  priority    String    @default("medium") // low | medium | high | urgent
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assignees   TaskAssignee[]
  creatorId   String
  creator     User      @relation("TaskCreator", fields: [creatorId], references: [id])
  dueDate     DateTime?
  tags        String    @default("[]") // JSON array of strings
  parentTaskId String?
  parentTask  Task?     @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks    Task[]    @relation("Subtasks")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  calendarEvents CalendarEvent[]
}

model TaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([taskId, userId])
}

model Note {
  id         String    @id @default(cuid())
  title      String
  content    String    @default("")
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  isPinned   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String   @default("#0F7B8A")
  icon        String?
  description String?
  createdAt   DateTime @default(now())

  notes Note[]
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // created | updated | completed | commented | assigned | deleted
  entityType String   // task | project | note | user
  entityId   String
  entityName String   @default("")
  metadata   String   @default("{}") // JSON
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // task_assigned | task_due | task_status_changed | note_created
  title     String
  body      String
  entityType String
  entityId  String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AiChat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String   // task-assistant | consultant
  messages  String   @default("[]") // JSON array of {role, content, timestamp}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mode])
}

model DailyBriefing {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  content   String
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("event") // event | meeting | deadline
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean  @default(false)
  location    String?
  color       String?
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User     @relation("EventCreator", fields: [createdById], references: [id])
  attendees   EventAttendee[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EventAttendee {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model ChatRoom {
  id          String       @id @default(cuid())
  name        String?      // null for DMs, required for group chats
  isGroup     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String
  createdBy   User         @relation("ChatRoomCreator", fields: [createdById], references: [id])
  members     ChatMember[]
  messages    ChatMessage[]
}

model ChatMember {
  id         String    @id @default(cuid())
  roomId     String
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  @@unique([roomId, userId])
}

model ChatMessage {
  id        String    @id @default(cuid())
  roomId    String
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation(fields: [senderId], references: [id])
  content   String
  editedAt  DateTime?
  createdAt DateTime  @default(now())
}

model CompanySettings {
  id          String   @id @default("singleton")
  name        String   @default("Aequora Digital")
  description String?
  logoUrl     String?
  primaryColor String  @default("#0F7B8A")
  updatedAt   DateTime @updatedAt
}

model CompanyDocument {
  id           String   @id @default(cuid())
  name         String
  description  String?
  url          String
  fileSize     Int?
  mimeType     String?
  uploadedById String
  uploadedBy   User     @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model EmailSignature {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GmailToken {
  id           String   @id @default(cuid())
  email        String   @unique
  accessToken  String
  refreshToken String
  expiryDate   BigInt
  updatedAt    DateTime @updatedAt
  ownerId      String?
  owner        User?    @relation("GmailTokenOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // Watermark for the new-mail notification cron — messages received after
  // this are "new" since the last check; null means never checked yet (the
  // first run just sets this without notifying, to avoid flooding everyone
  // with notifications for an entire mailbox's history).
  lastCheckedAt DateTime?
  // Which connected account (per ownerId group — agency accounts share
  // ownerId: null) opens by default in Conversations/Inbox. At most one per
  // owner group should be true; enforced in code, not the DB.
  isPrimary Boolean @default(false)

  @@index([ownerId])
}

// --- Leads / Prospecting ---

model Lead {
  id                        String    @id @default(cuid())
  googlePlaceId             String    @unique
  name                      String
  category                  String?
  businessStatus            String?   // OPERATING | CLOSED_TEMPORARILY | CLOSED_PERMANENTLY
  phone                     String?
  website                   String?
  rating                    Float?
  reviewCount                Int       @default(0)
  address                   String?
  city                      String?
  state                     String?
  country                   String?
  lat                       Float?
  lng                       Float?
  opportunityScore          Int       @default(0)
  opportunityScoreUpdatedAt DateTime?
  enrichedEmail             String?
  // Best-effort MX lookup on enrichedEmail's domain -- null = not checked
  // (e.g. no email found), true = domain accepts mail, false = no MX record found.
  enrichedEmailValid        Boolean?
  // Best-effort guess at the email owner's name, derived only when the local
  // part looks personal (e.g. "john.smith@") rather than generic ("info@").
  enrichedOwnerName         String?
  enrichedFacebookUrl       String?
  enrichedInstagramUrl      String?
  enrichedLinkedinUrl       String?
  enrichedTwitterUrl        String?
  enrichedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // The most recent search that surfaced this business — lets the results
  // table show exactly what a search found instead of re-guessing via fuzzy
  // category/location text matching against the whole shared table.
  lastSearchId String?
  lastSearch   LeadSearch? @relation(fields: [lastSearchId], references: [id], onDelete: SetNull)

  audit        LeadAudit?
  savedByUsers SavedLead[]
  contacts     Contact[]
  people       LeadPerson[]
  hiringPosts  RemoteHiringPost[]
}

// A decision-maker found at a Lead's business — via website crawl, email
// pattern inference, or a country business registry. Kept separate from
// Contact (mirrors Lead -> SavedLead -> Contact): this is prospect data, not
// yet something the user has decided to reach out to.
model LeadPerson {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name   String?
  title  String?
  // Case-insensitive substring match of `title` against the user's target
  // title list (see DEFAULT_ICP_TITLES) -- lets the People tab prioritize
  // decision-makers instead of every name found on a site.
  matchesIcpTitle Boolean @default(false)
  email           String?
  emailSource     String? // scraped | pattern_guess | registry
  // Best-effort MX lookup on email's domain, same semantics as
  // Lead.enrichedEmailValid. Never implies the specific mailbox exists.
  emailValid Boolean?
  phone      String?
  source     String // website_crawl | pattern_inference | registry_gb | registry_us | registry_au
  // Reflects how the record was found, not the accuracy of any single field:
  // high = name+email both found directly on a page; medium = name found
  // directly but email is a verified-domain pattern guess; low = anything
  // guessed further (unverified pattern guess, or name itself inferred).
  confidence String  @default("low") // high | medium | low
  foundOnUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Which auto-discovery search (Position + Industry + Location) produced
  // this row, if any -- null means found manually via "Find People" on a
  // business in the Company tab. This is what keeps the People tab's "Found
  // People" and "People Search" results genuinely separate instead of just
  // visually distinguished.
  peopleSearchId String?
  peopleSearch   PeopleSearch? @relation(fields: [peopleSearchId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

// A Position + Industry + Location search that auto-discovers companies
// (via the same Google Places search as the Company tab, tagged as a normal
// LeadSearch) and crawls a capped first batch of them for people -- distinct
// from manually clicking "Find People" on businesses you've already chosen.
model PeopleSearch {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation("PeopleSearchOwner", fields: [userId], references: [id], onDelete: Cascade)
  position         String
  industry         String
  location         String
  companiesFound   Int      @default(0) // total businesses the Places search returned
  companiesCrawled Int      @default(0) // how many were actually crawled (capped)
  createdAt        DateTime @default(now())

  people      LeadPerson[]
  hiringPosts RemoteHiringPost[]
}

// One "we're hiring remotely" job post pulled from a public remote job board
// (Remotive, more sources may follow) — the actual hiring signal a Remote
// Hiring search surfaces. Kept separate from Lead/LeadPerson: a job post has
// no Google Place of its own, so it's matched to a Lead only best-effort (by
// company name) and stands on its own (companyName/position/applyUrl) when
// no match is found or the company has no Google Business Profile at all.
model RemoteHiringPost {
  id                String        @id @default(cuid())
  peopleSearchId    String
  peopleSearch      PeopleSearch  @relation(fields: [peopleSearchId], references: [id], onDelete: Cascade)
  source            String        // remotive
  externalId        String        // dedupe key from the source API, unique per source
  companyName       String
  position          String        // the job title being hired for -- the pitch hook ("saw you're hiring for X")
  candidateLocation String?       // source's free-text location restriction, e.g. "USA only", "Worldwide"
  applyUrl          String
  // Best-effort company site: a link pulled from the job description, or a
  // Google Places match by company name when the description had none.
  // Null means neither resolved -- the post still surfaces with just
  // company/position/applyUrl for manual research.
  companyWebsite    String?
  leadId            String?
  lead              Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())

  @@unique([source, externalId])
  @@index([peopleSearchId])
}

model LeadAudit {
  id                 String   @id @default(cuid())
  leadId             String   @unique
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  performanceScore   Int?
  seoScore           Int?
  accessibilityScore Int?
  bestPracticesScore Int?
  mobileFriendly     Boolean?
  httpsEnabled       Boolean?
  hasMetaDescription Boolean?
  hasTitle           Boolean?
  sslValid           Boolean?
  pageSpeed          Float?
  overallScore       Int?
  // AI-generated ("Get AI Recommendations" button) — plain text, regenerated on
  // demand, not tied to lastScanned since someone may want fresh advice without
  // re-running the underlying PageSpeed audit.
  aiRecommendations   String?
  aiRecommendationsAt DateTime?
  lastScanned        DateTime @default(now())
  createdAt          DateTime @default(now())
}

model SavedLead {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("SavedLeadOwner", fields: [userId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status       String    @default("New") // New | Contacted | Meeting Scheduled | Proposal Sent | Won | Lost
  notes        String?
  tags         String    @default("[]") // JSON array of strings
  followUpDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, leadId])
}

model LeadSearch {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("LeadSearchOwner", fields: [userId], references: [id], onDelete: Cascade)
  keyword      String
  location     String
  radius       Int?
  resultsCount Int      @default(0)
  createdAt    DateTime @default(now())

  leads Lead[]
}

// --- Contacts ---

model Contact {
  id           String   @id @default(cuid())
  createdById  String
  createdBy    User     @relation("ContactCreator", fields: [createdById], references: [id], onDelete: Cascade)
  name         String
  firstName    String?
  lastName     String?
  company      String?
  email        String?
  additionalEmails String @default("[]") // JSON array of extra email strings
  phone        String?
  website      String?
  facebookUrl  String?
  instagramUrl String?
  linkedinUrl  String?
  twitterUrl   String?
  address      String?
  notes        String?
  tags         String   @default("[]") // JSON array of strings
  eventDate    DateTime? // set by the "Set Event Date" automation action; consumed by Wait's "before/after event date" mode
  sourceLeadId String?
  sourceLead   Lead?    @relation(fields: [sourceLeadId], references: [id], onDelete: SetNull)
  // Role at the time this Contact was saved, e.g. from LeadPerson.title when
  // saved via the People tab. Not synced afterward.
  title        String?
  assignedToId String?
  assignedTo   User?    @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  // Free syntax + MX-record check (no paid verification API) -- "valid" means
  // well-formed and the domain has a mail server, not that the mailbox
  // itself exists. Re-checked on demand via bulk-verify; cached otherwise so
  // sends don't re-run DNS lookups every time.
  emailVerificationStatus String? // valid | invalid | unknown
  emailVerifiedAt         DateTime?
  // Set by the daily bounce-scan (see cron/check-new-mail) matching a
  // mailer-daemon/postmaster bounce-back to a previously tracked send.
  // Bounced contacts are excluded from future sends automatically.
  emailBounced       Boolean   @default(false)
  emailBouncedAt      DateTime?
  emailBounceReason   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  opportunities Opportunity[]
  automationRuns AutomationRun[]
  emailTracking EmailTracking[]
  calls          Call[]
  sites          Site[]
  customFieldValues ContactCustomFieldValue[]
}

// Account-wide reusable snippet (e.g. "Company Support Phone") -- GHL-style
// Custom Value, referenced in email/automation bodies as {{custom_values.<key>}}
// (see lib/automation/mergeTags.ts). Unlike a Custom Field, this isn't tied
// to a Contact -- it's one value shared everywhere the token is used.
model CustomValue {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique // slug used in the merge token, e.g. "company_support_phone"
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A user-defined field on Contact records (GHL-style Custom Field) -- lets
// the team track data points beyond Contact's fixed columns without a schema
// change per field. Values live in ContactCustomFieldValue (EAV) rather than
// as real columns here, since the set of fields is user-editable at runtime.
model CustomFieldDefinition {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique // slug used to key a contact's value, e.g. "birthday"
  type      String   // text | number | date | dropdown | checkbox | textarea
  options   String   @default("[]") // JSON array of strings -- only meaningful when type = dropdown
  required  Boolean  @default(false)
  order     Int      @default(0) // display order in the field list and on the Contact form
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values ContactCustomFieldValue[]
}

model ContactCustomFieldValue {
  id        String                @id @default(cuid())
  contactId String
  contact   Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  fieldId   String
  field     CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value     String                // raw string; interpretation (number/date/checkbox) follows field.type
  updatedAt DateTime              @updatedAt

  @@unique([contactId, fieldId])
  @@index([fieldId])
}

// --- Pipeline / Opportunities ---

model Pipeline {
  id            String          @id @default(cuid())
  name          String
  createdAt     DateTime        @default(now())
  stages        PipelineStage[]
  opportunities Opportunity[]
}

model PipelineStage {
  id            String        @id @default(cuid())
  pipelineId    String
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name          String
  order         Int
  opportunities Opportunity[]
}

model Opportunity {
  id          String        @id @default(cuid())
  name        String
  value       Float?
  status      String        @default("open") // open | won | lost
  contactId   String
  contact     Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  pipelineId  String
  pipeline    Pipeline      @relation(fields: [pipelineId], references: [id])
  stageId     String
  stage       PipelineStage @relation(fields: [stageId], references: [id])
  notes       String?
  createdById String
  createdBy   User          @relation("OpportunityCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// --- Automation ---

model Automation {
  id          String          @id @default(cuid())
  name        String
  isActive    Boolean         @default(true)
  // Contact entry control -- default true/true preserves this app's original
  // behavior (every trigger fire enrolls, with no dedup) for automations that
  // existed before these settings shipped.
  allowMultipleEntries Boolean @default(true) // false = a contact already actively running/waiting in this automation is skipped on a repeat trigger
  allowReentry         Boolean @default(true) // false = a contact who already finished a run here (any terminal status) is skipped on a repeat trigger
  // Bearer secret for the inbound "Webhook Received" trigger -- the URL
  // /api/automations/webhook/[webhookSecret] is unauthenticated by design (external
  // senders can't do OAuth), so this value alone gates who can fire the automation.
  // Uses a dbgenerated (database-computed) default rather than @default(cuid()) --
  // `prisma db push` can only backfill a NOT NULL column on existing rows when the
  // database itself can compute the value; cuid() is generated in the Prisma client,
  // not SQL, so it can't be applied by an ALTER TABLE against live data. This only
  // matters for the one-time backfill of rows that predate this column -- every
  // new/regenerated secret is overwritten with a crypto.randomBytes value from
  // application code, which is not guessable like this fallback.
  webhookSecret String        @unique @default(dbgenerated("md5((random())::text || (clock_timestamp())::text)"))
  flow        String          @default("{\"nodes\":[],\"edges\":[]}") // React Flow nodes+edges, JSON string
  createdById String
  createdBy   User            @relation("AutomationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  runs        AutomationRun[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model AutomationRun {
  id            String                    @id @default(cuid())
  automationId  String
  automation    Automation                @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?                  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status        String                    // running | waiting | completed | error
  currentNodeId String?
  waitUntil     DateTime?
  waitToken     String?                   @unique
  detail        String?
  payload       String?                   // JSON body the inbound webhook trigger was fired with, if any -- exposed to later steps as {{webhook.*}}
  variables     String?                   // JSON map of {responseVariableName: parsedResponseBody}, accumulated by HTTP/Webhook steps -- exposed as {{http.<name>.*}}
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  emailTracking EmailTracking[]
  steps         AutomationRunStep[]
}

model AutomationRunStep {
  id       String        @id @default(cuid())
  runId    String
  run      AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId   String
  nodeType String
  status   String        // success | error | waiting
  detail   String?
  createdAt DateTime     @default(now())
}

model EmailTracking {
  id             String         @id @default(cuid())
  token          String         @unique
  contactId      String?
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  runId          String?
  run            AutomationRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  gmailMessageId String?
  gmailThreadId  String?
  openedAt       DateTime?
  // Set by the daily bounce-scan when a mailer-daemon/postmaster bounce-back
  // is matched to this send's thread.
  bounced        Boolean        @default(false)
  bouncedAt      DateTime?
  bounceReason   String?
  // Set when an inbound message on this thread, from the original recipient
  // and after this send, is seen during the daily inbox scan.
  repliedAt      DateTime?
  createdAt      DateTime       @default(now())

  @@index([gmailThreadId])
}

// --- Calling (Twilio) ---

// Singleton, same pattern as CompanySettings. Holds the agency's Twilio
// account connection (entered once via Settings → Calling — "Connect
// Twilio" — instead of Vercel env vars) plus the one purchased number used
// as caller ID for every outbound click-to-call. The API Key and TwiML App
// are auto-provisioned by our backend from accountSid/authToken at connect
// time, so the admin only ever has to paste those two values.
model TwilioSettings {
  id             String   @id @default("singleton")
  accountSid     String?
  authToken      String?
  apiKeySid      String? // auto-created via the Twilio REST API at connect time
  apiKeySecret   String? // only ever returned once by Twilio at creation; stored here
  twimlAppSid    String? // auto-created Voice TwiML App pointing at /api/twilio/voice
  phoneNumberSid String? // Twilio's IncomingPhoneNumber SID, once purchased
  phoneNumber    String? // E.164, e.g. +15551234567
  updatedAt      DateTime @updatedAt
}

model Call {
  id            String   @id @default(cuid())
  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  userId        String
  user          User     @relation("CallInitiator", fields: [userId], references: [id], onDelete: Cascade)
  toNumber      String
  fromNumber    String
  // queued | ringing | in-progress | completed | failed | busy | no-answer | canceled
  status        String   @default("queued")
  durationSec   Int?
  twilioCallSid String?  @unique
  // Set once Twilio finishes processing the recording (recordingStatusCallback,
  // "completed"). recordingUrl is Twilio's own API URL, not directly playable —
  // audio is fetched server-side via /api/calls/[id]/recording so the browser
  // never needs Twilio credentials.
  recordingSid         String? @unique
  recordingUrl         String?
  recordingDurationSec Int?
  // Twilio's Answering Machine Detection result: human | machine_start |
  // machine_end_beep | machine_end_silence | machine_end_other | fax |
  // unknown | null (not yet reported, or AMD off). Purely informational --
  // doesn't change how the call is handled, just lets the UI flag "this
  // reached voicemail."
  answeredBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([contactId])
}

// --- Website Builder ---
// Phase 1 (this migration): Site/Page/PageVersion/SiteAsset only -- proves draft/publish
// separation and truly public rendering end-to-end. Custom domains (SiteDomain) and
// reusable components (SiteSymbol) are later phases, deliberately not modeled yet.

model Site {
  id          String   @id @default(cuid())
  name        String // internal label, e.g. "Acme Corp -- Marketing Site"
  slug        String   @unique // used in the default preview path /p/[slug]
  status      String   @default("draft") // draft | published | archived -- has this site EVER been published
  faviconUrl  String?
  themeTokens String   @default("{}") // JSON: {colors:{...}, fonts:{...}} -- global design tokens, consumed once the editor (Phase 2) exists
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User     @relation("SiteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pages  Page[]
  assets SiteAsset[]
}

model Page {
  id         String @id @default(cuid())
  siteId     String
  site       Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  slug       String
  title      String
  // Enforced in application code, not the DB -- same "enforced in code" pattern as
  // GmailToken.isPrimary. At most one true per site; the homepage is served at /p/[siteSlug]
  // with no further path segments.
  isHomepage Boolean @default(false)
  status     String  @default("draft") // draft | published -- page-level, more granular than Site.status

  // Editing always reads/writes draftContent. Publishing copies draftContent ->
  // publishedContent + sets publishedAt; the public render path reads ONLY
  // publishedContent where status = "published", so further draft edits never go live
  // until Publish is clicked again. JSON PageContent shape -- see src/lib/site-builder/types.ts.
  draftContent     String    @default("{\"blocks\":[]}")
  publishedContent String?
  publishedAt      DateTime?

  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  canonicalUrl    String?
  noIndex         Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions PageVersion[]

  @@unique([siteId, slug])
}

// Immutable snapshot log, written on every Publish -- same append-only audit-log shape
// as AutomationRunStep. Gives real version history/restore, not just in-session undo.
model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  content     String // JSON snapshot of PageContent at this point
  label       String? // "Published" | "Autosave" | custom
  createdById String?
  createdBy   User?    @relation("PageVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

// Per-site media library row -- same shape as CompanyDocument. Uploaded via the shared
// /api/upload endpoint (src/app/api/upload/route.ts), URL stored here for reuse across pages.
model SiteAsset {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url          String
  filename     String
  mimeType     String?
  fileSize     Int?
  width        Int?
  height       Int?
  uploadedById String
  uploadedBy   User     @relation("SiteAssetUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}
