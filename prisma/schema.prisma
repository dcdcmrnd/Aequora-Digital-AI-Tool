generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String?
  role        String    @default("member") // admin | member
  avatarUrl   String?
  status      String    @default("invited") // invited | active | suspended
  invitedAt   DateTime?
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions   UserPermission[]
  projectAccess ProjectAccess[]
  ownedProjects Project[]        @relation("ProjectOwner")
  assignedTasks    Task[]           @relation("TaskAssignee")
  createdTasks     Task[]           @relation("TaskCreator")
  taskAssignments  TaskAssignee[]
  emailSignatures  EmailSignature[]
  notes         Note[]
  activities    ActivityLog[]
  notifications Notification[]
  sentInvites       Invitation[]      @relation("InvitedBy")
  aiChats           AiChat[]
  uploadedDocuments CompanyDocument[] @relation("DocumentUploader")
  createdEvents  CalendarEvent[]  @relation("EventCreator")
  eventAttendees EventAttendee[]
  chatRoomsCreated ChatRoom[]     @relation("ChatRoomCreator")
  chatMemberships  ChatMember[]
  chatMessages     ChatMessage[]
  savedLeads       SavedLead[]    @relation("SavedLeadOwner")
  leadSearches     LeadSearch[]   @relation("LeadSearchOwner")
  contactsCreated  Contact[]      @relation("ContactCreator")
  opportunitiesCreated Opportunity[] @relation("OpportunityCreator")
  automationsCreated   Automation[]  @relation("AutomationCreator")
  passwordResetTokens  PasswordResetToken[]
  gmailTokens          GmailToken[]         @relation("GmailTokenOwner")
  assignedContacts     Contact[]            @relation("ContactAssignee")
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  name        String
  role        String    @default("member")
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  defaultPermissions String @default("[]") // JSON array of permission types
  projectAccess      String @default("[]") // JSON array of {projectId, accessLevel}
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model UserPermission {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionType String
  createdAt      DateTime @default(now())

  @@unique([userId, permissionType])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("active") // active | on-hold | completed | archived
  color       String    @default("#0F7B8A")
  ownerId     String
  owner       User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  isPrivate   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks         Task[]
  notes         Note[]
  projectAccess ProjectAccess[]
}

model ProjectAccess {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accessLevel String   @default("viewer") // viewer | contributor | manager
  grantedById String
  createdAt   DateTime @default(now())

  @@unique([userId, projectId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("todo") // backlog | todo | in-progress | review | done
  priority    String    @default("medium") // low | medium | high | urgent
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assignees   TaskAssignee[]
  creatorId   String
  creator     User      @relation("TaskCreator", fields: [creatorId], references: [id])
  dueDate     DateTime?
  tags        String    @default("[]") // JSON array of strings
  parentTaskId String?
  parentTask  Task?     @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks    Task[]    @relation("Subtasks")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  calendarEvents CalendarEvent[]
}

model TaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([taskId, userId])
}

model Note {
  id         String    @id @default(cuid())
  title      String
  content    String    @default("")
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  isPinned   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String   @default("#0F7B8A")
  icon        String?
  description String?
  createdAt   DateTime @default(now())

  notes Note[]
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // created | updated | completed | commented | assigned | deleted
  entityType String   // task | project | note | user
  entityId   String
  entityName String   @default("")
  metadata   String   @default("{}") // JSON
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // task_assigned | task_due | task_status_changed | note_created
  title     String
  body      String
  entityType String
  entityId  String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AiChat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String   // task-assistant | consultant
  messages  String   @default("[]") // JSON array of {role, content, timestamp}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mode])
}

model DailyBriefing {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  content   String
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("event") // event | meeting | deadline
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean  @default(false)
  location    String?
  color       String?
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User     @relation("EventCreator", fields: [createdById], references: [id])
  attendees   EventAttendee[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EventAttendee {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model ChatRoom {
  id          String       @id @default(cuid())
  name        String?      // null for DMs, required for group chats
  isGroup     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String
  createdBy   User         @relation("ChatRoomCreator", fields: [createdById], references: [id])
  members     ChatMember[]
  messages    ChatMessage[]
}

model ChatMember {
  id         String    @id @default(cuid())
  roomId     String
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  @@unique([roomId, userId])
}

model ChatMessage {
  id        String    @id @default(cuid())
  roomId    String
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation(fields: [senderId], references: [id])
  content   String
  editedAt  DateTime?
  createdAt DateTime  @default(now())
}

model CompanySettings {
  id          String   @id @default("singleton")
  name        String   @default("Aequora Digital")
  description String?
  logoUrl     String?
  primaryColor String  @default("#0F7B8A")
  updatedAt   DateTime @updatedAt
}

model CompanyDocument {
  id           String   @id @default(cuid())
  name         String
  description  String?
  url          String
  fileSize     Int?
  mimeType     String?
  uploadedById String
  uploadedBy   User     @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model EmailSignature {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GmailToken {
  id           String   @id @default(cuid())
  email        String   @unique
  accessToken  String
  refreshToken String
  expiryDate   BigInt
  updatedAt    DateTime @updatedAt
  ownerId      String?
  owner        User?    @relation("GmailTokenOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// --- Leads / Prospecting ---

model Lead {
  id                        String    @id @default(cuid())
  googlePlaceId             String    @unique
  name                      String
  category                  String?
  businessStatus            String?   // OPERATING | CLOSED_TEMPORARILY | CLOSED_PERMANENTLY
  phone                     String?
  website                   String?
  rating                    Float?
  reviewCount                Int       @default(0)
  address                   String?
  city                      String?
  state                     String?
  country                   String?
  lat                       Float?
  lng                       Float?
  opportunityScore          Int       @default(0)
  opportunityScoreUpdatedAt DateTime?
  enrichedEmail             String?
  enrichedFacebookUrl       String?
  enrichedInstagramUrl      String?
  enrichedLinkedinUrl       String?
  enrichedTwitterUrl        String?
  enrichedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // The most recent search that surfaced this business — lets the results
  // table show exactly what a search found instead of re-guessing via fuzzy
  // category/location text matching against the whole shared table.
  lastSearchId String?
  lastSearch   LeadSearch? @relation(fields: [lastSearchId], references: [id], onDelete: SetNull)

  audit        LeadAudit?
  savedByUsers SavedLead[]
  contacts     Contact[]
}

model LeadAudit {
  id                 String   @id @default(cuid())
  leadId             String   @unique
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  performanceScore   Int?
  seoScore           Int?
  accessibilityScore Int?
  bestPracticesScore Int?
  mobileFriendly     Boolean?
  httpsEnabled       Boolean?
  hasMetaDescription Boolean?
  hasTitle           Boolean?
  sslValid           Boolean?
  pageSpeed          Float?
  overallScore       Int?
  lastScanned        DateTime @default(now())
  createdAt          DateTime @default(now())
}

model SavedLead {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("SavedLeadOwner", fields: [userId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status       String    @default("New") // New | Contacted | Meeting Scheduled | Proposal Sent | Won | Lost
  notes        String?
  tags         String    @default("[]") // JSON array of strings
  followUpDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, leadId])
}

model LeadSearch {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("LeadSearchOwner", fields: [userId], references: [id], onDelete: Cascade)
  keyword      String
  location     String
  radius       Int?
  resultsCount Int      @default(0)
  createdAt    DateTime @default(now())

  leads Lead[]
}

// --- Contacts ---

model Contact {
  id           String   @id @default(cuid())
  createdById  String
  createdBy    User     @relation("ContactCreator", fields: [createdById], references: [id], onDelete: Cascade)
  name         String
  firstName    String?
  lastName     String?
  company      String?
  email        String?
  additionalEmails String @default("[]") // JSON array of extra email strings
  phone        String?
  website      String?
  facebookUrl  String?
  instagramUrl String?
  linkedinUrl  String?
  twitterUrl   String?
  address      String?
  notes        String?
  tags         String   @default("[]") // JSON array of strings
  sourceLeadId String?
  sourceLead   Lead?    @relation(fields: [sourceLeadId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?    @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  opportunities Opportunity[]
  automationRuns AutomationRun[]
  emailTracking EmailTracking[]
}

// --- Pipeline / Opportunities ---

model Pipeline {
  id            String          @id @default(cuid())
  name          String
  createdAt     DateTime        @default(now())
  stages        PipelineStage[]
  opportunities Opportunity[]
}

model PipelineStage {
  id            String        @id @default(cuid())
  pipelineId    String
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name          String
  order         Int
  opportunities Opportunity[]
}

model Opportunity {
  id          String        @id @default(cuid())
  name        String
  value       Float?
  status      String        @default("open") // open | won | lost
  contactId   String
  contact     Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  pipelineId  String
  pipeline    Pipeline      @relation(fields: [pipelineId], references: [id])
  stageId     String
  stage       PipelineStage @relation(fields: [stageId], references: [id])
  notes       String?
  createdById String
  createdBy   User          @relation("OpportunityCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// --- Automation ---

model Automation {
  id          String          @id @default(cuid())
  name        String
  isActive    Boolean         @default(true)
  flow        String          @default("{\"nodes\":[],\"edges\":[]}") // React Flow nodes+edges, JSON string
  createdById String
  createdBy   User            @relation("AutomationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  runs        AutomationRun[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model AutomationRun {
  id            String                    @id @default(cuid())
  automationId  String
  automation    Automation                @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?                  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status        String                    // running | waiting | completed | error
  currentNodeId String?
  waitUntil     DateTime?
  waitToken     String?                   @unique
  detail        String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  emailTracking EmailTracking[]
  steps         AutomationRunStep[]
}

model AutomationRunStep {
  id       String        @id @default(cuid())
  runId    String
  run      AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId   String
  nodeType String
  status   String        // success | error | waiting
  detail   String?
  createdAt DateTime     @default(now())
}

model EmailTracking {
  id             String         @id @default(cuid())
  token          String         @unique
  contactId      String?
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  runId          String?
  run            AutomationRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  gmailMessageId String?
  gmailThreadId  String?
  openedAt       DateTime?
  createdAt      DateTime       @default(now())

  @@index([gmailThreadId])
}
