{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/resume-automations",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/check-new-mail",
      "schedule": "0 13 * * *"
    }
  ]
}
