# PostgreSQL — use Vercel Postgres, Supabase, Neon, or any PostgreSQL provider
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"

# Set to your production URL on Vercel (e.g. https://your-app.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

ANTHROPIC_API_KEY="sk-ant-..."

# Optional — for sending invite emails automatically
# If not set, admin copies the invite link manually
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="team@aequora.digital"

# --- People tab: country business registry lookups (all optional) ---

# UK — Companies House, free official API. Get a key at
# https://developer.company-information.service.gov.uk (no subscription).
COMPANIES_HOUSE_API_KEY=""

# US — OpenCorporates, free tier works without a key at a low rate limit; an
# optional free key raises the limit. https://opencorporates.com/api_accounts/new
OPENCORPORATES_API_KEY=""

# AU — there's no free official source for company director names (only
# ABN Lookup for sole traders, which needs nothing here). Full director data
# requires your own paid ASIC Connect account — leave unset until you have
# one; the People tab surfaces the per-lookup cost and requires confirmation
# before ever running a paid lookup.
ASIC_CONNECT_ENABLED="false"
ASIC_CONNECT_ACCOUNT_ID=""
